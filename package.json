{
  "name": "radar-ofertas",
  "version": "1.0.0",
  "description": "Crawler de ofertas de e-commerce (Magalu, Amazon, Mercado Livre) com histórico de preços, detecção de promoção real, notificação Telegram, feedback de recomendação e análise via LiteLLM.",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "crawl": "RUN_MODE=CRAWL bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "jsdom": "^23.0.0",
    "playwright": "^1.43.0",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "private": true
}
