# ── Execução ──────────────────────────────────────────────────────────────
RUN_MODE=SERVER            # SERVER (api+dashboard) | CRAWL (job único)
PORT=3005
DB_PATH=./data/radar.sqlite
LOG_LEVEL=info
CRAWL_INTERVAL_MIN=60      # ciclo contínuo no modo SERVER (minutos); 0 desliga

# ── Crawler ─────────────────────────────────────────────────────────────────
# Disponíveis: mercadolivre,amazon,magalu,kabum,aliexpress,shopee,zoom,buscape,casasbahia,pontofrio,extra
# casasbahia/pontofrio/extra dependem de IP residencial (Akamai bloqueia datacenter).
# zoom/buscape são comparadores: 1 GET devolve ~30 produtos com o menor preço de mercado.
CRAWL_SOURCES=mercadolivre,amazon,magalu,kabum,aliexpress,shopee,zoom,buscape
CRAWL_QUERIES=whey protein,ssd nvme,monitor gamer,cadeira gamer,echo dot,creatina
MAX_PER_QUERY=8
CRAWL_CONCURRENCY=4        # fontes coletadas em paralelo (throttle por host segue interno)

# ── Detecção de oferta ──────────────────────────────────────────────────────
MIN_HISTORY_POINTS=3
Z_THRESHOLD=1.2
MIN_DISCOUNT_PCT=12
NOTIFY_SCORE=0.5
# veredito PASSE da IA não vira alerta no Telegram (a oferta fica no dashboard)
AI_SKIP_PASS=true
PRICE_BUG_DISCOUNT_PCT=70  # desconto >= % vs média = provável erro de preço
MAX_NOTIFICATIONS_PER_CYCLE=10  # teto de mensagens/ciclo; ofertas restantes ficam gravadas
MIN_HISTORY_HOURS=24       # histórico precisa cobrir N horas p/ valer como "preço normal"
LISTPRICE_MIN_DISCOUNT_PCT=20  # sem histórico: desconto mínimo vs preço "de" (+10 na Black Friday)
LISTPRICE_NOTIFY=market    # market (só se for o menor entre lojas) | always | never
REDEAL_DROP_PCT=5          # mesmo produto volta a alertar se cair mais X%
MARKET_TOLERANCE_PCT=3     # outra loja mais barata que isso derruba a oferta
POPULARITY_WEIGHT=1        # peso de mais vendido/avaliações no score (0 desliga)
BESTSELLER_SOURCES=mercadolivre,amazon
TELEGRAM_MIN_INTERVAL_MS=3200

# ── Black Friday ────────────────────────────────────────────────────────────
SEASON_MODE=auto           # auto | off | force
BF_BASELINE_CUTOFF=        # vazio = 1/nov do ano; preços antes disso = "preço normal"
BF_CRAWL_INTERVAL_MIN=30
BF_PEAK_CRAWL_INTERVAL_MIN=15
BF_MAX_NOTIFICATIONS_PER_CYCLE=20
BF_QUERIES=iphone,smartphone samsung galaxy,smart tv 55,notebook,air fryer,fone bluetooth,smartwatch,geladeira,ps5,aspirador robo,kindle,echo dot

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=         # bot precisa ser ADMIN do canal; chat_id errado => "chat not found" (400)
TELEGRAM_POLL_CALLBACKS=false  # 👍/👎 via long-polling; false se o bot for compartilhado (n8n) p/ evitar 409

# ── Banco do cluster (Postgres) p/ ofertas reais ────────────────────────────
# Vazio => só SQLite local. Em produção, aponte p/ o Postgres do cluster.
CLUSTER_DATABASE_URL=postgresql://USER:PASS@postgres.databases.svc.cluster.local:5432/radar_ofertas

# ── LiteLLM (OpenAI-compatível) ─────────────────────────────────────────────
LITELLM_ENABLED=true
LITELLM_API_BASE=http://litellm.ai.svc.cluster.local:4000/v1
LITELLM_API_KEY=

# Protege POST /api/crawl e POST/DELETE /api/queries (Bearer ou x-admin-token). Vazio = aberto.
ADMIN_TOKEN=
LITELLM_MODEL=cloud/llama-8b
LITELLM_TIMEOUT_MS=45000
