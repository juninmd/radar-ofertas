# ── Execução ──────────────────────────────────────────────────────────────
RUN_MODE=SERVER            # SERVER (api+dashboard) | CRAWL (job único)
PORT=3005
DB_PATH=./data/radar.sqlite
LOG_LEVEL=info
CRAWL_INTERVAL_MIN=0       # >0 agenda ciclo interno no modo SERVER

# ── Crawler ─────────────────────────────────────────────────────────────────
CRAWL_SOURCES=mercadolivre,amazon,magalu
CRAWL_QUERIES=whey protein,ssd nvme,monitor gamer,cadeira gamer,echo dot,creatina
MAX_PER_QUERY=8
ALLOW_DEMO_FALLBACK=true   # usa catálogo sintético quando o site bloqueia (anti-bot)

# ── Detecção de oferta ──────────────────────────────────────────────────────
MIN_HISTORY_POINTS=3
Z_THRESHOLD=1.2
MIN_DISCOUNT_PCT=12
NOTIFY_SCORE=0.5

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LiteLLM (OpenAI-compatível) ─────────────────────────────────────────────
LITELLM_ENABLED=true
LITELLM_API_BASE=http://litellm.ai.svc.cluster.local:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=cloud/llama-8b
LITELLM_TIMEOUT_MS=45000
