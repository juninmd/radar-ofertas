# ── Execução ──────────────────────────────────────────────────────────────
RUN_MODE=SERVER            # SERVER (api+dashboard) | CRAWL (job único)
PORT=3005
DB_PATH=./data/radar.sqlite
LOG_LEVEL=info
CRAWL_INTERVAL_MIN=60      # ciclo contínuo no modo SERVER (minutos); 0 desliga

# ── Crawler ─────────────────────────────────────────────────────────────────
# Disponíveis: mercadolivre,amazon,magalu,kabum,aliexpress,shopee,casasbahia,pontofrio,extra
# casasbahia/pontofrio/extra dependem de IP residencial (Akamai bloqueia datacenter).
CRAWL_SOURCES=mercadolivre,amazon,magalu,kabum,aliexpress,shopee
CRAWL_QUERIES=whey protein,ssd nvme,monitor gamer,cadeira gamer,echo dot,creatina
MAX_PER_QUERY=8

# ── Detecção de oferta ──────────────────────────────────────────────────────
MIN_HISTORY_POINTS=3
Z_THRESHOLD=1.2
MIN_DISCOUNT_PCT=12
NOTIFY_SCORE=0.5
PRICE_BUG_DISCOUNT_PCT=70  # desconto >= % vs média = provável erro de preço

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=         # bot precisa ser ADMIN do canal; chat_id errado => "chat not found" (400)
TELEGRAM_POLL_CALLBACKS=false  # 👍/👎 via long-polling; false se o bot for compartilhado (n8n) p/ evitar 409

# ── LiteLLM (OpenAI-compatível) ─────────────────────────────────────────────
LITELLM_ENABLED=true
LITELLM_API_BASE=http://litellm.ai.svc.cluster.local:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=cloud/llama-8b
LITELLM_TIMEOUT_MS=45000
